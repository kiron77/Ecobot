# ============================================================================
#  EcoBot — environment variables
#  Copy this file to ".env" and fill in the values. Never commit your real .env.
# ============================================================================

# ---- REQUIRED: Database (Postgres) -----------------------------------------
# Local Postgres example (see LOCAL-SETUP.md for how to start one):
DATABASE_URL=postgresql://ecobot:ecobot@localhost:5432/ecobot

# ---- REQUIRED: Sprocket AI tutor (Google Gemini) ---------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Optional overrides (defaults are fine):
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---- AUTH (Clerk) ----------------------------------------------------------
# Two ways to run locally:
#
#  (A) EASIEST/RELIABLE — free Clerk dev keys (no credit card, ~2 min):
#      Sign up at https://clerk.com, create an app, copy the two keys below.
CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here
# The frontend needs the publishable key too (same value):
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
#
#  (B) NO-ACCOUNT DEV BYPASS — skip Clerk entirely for local clicking-around.
#      Set the flag below. The server will fake a logged-in user.
#      (Only works when NODE_ENV=development. Never use in production.)
DEV_AUTH_BYPASS=0

# ---- Payments (Stripe) — OPTIONAL for local dev ----------------------------
# The cart/shop needs these, but the rest of the app runs fine without them.
# Get test keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_your-key-here
# STRIPE_WEBHOOK_SECRET=whsec_your-key-here

# ---- Server basics ---------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
BASE_PATH=/
